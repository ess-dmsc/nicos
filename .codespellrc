[codespell]
skip = .git,.ci,test/root,nicos/*,nicostools/*,tools/*,bin/*,resources/*,conftest.py,test/utils.py,test/bin/*,test/faulty_setups/*,test/fixtures/*,test/nexus/*,test/scripts/*,test/script_templates/*,test/setups/*,test/test_basic/*,test/test_console/*,test/test_custom/*,test/test_daemon/*,test/test_gui/*,test/test_secop/*,test/test_simple/*,test/test_simulation/*,test/test_stresstest/*,nicos_mlz/*,nicos/authors.py,*.svg,*venv,uv.lock,log/*,nicos/guisupport/gui_rc_qt*.py,data/*,requirement*.txt,nicos_demo/*,doc/source/nicos_mlz/*,test_structure_loki.json,lima.rst,nicos/clients/gui/panels/search.ui
quiet-level = 2
ignore-words-list = mot,esponsible,LiveTime,rmove,inout,inbetween,LinZ,SOM,propT,ans,clen,aLine,Hart,hart,umit
